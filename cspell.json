{
  "version": "0.2",
  "language": "en,pt,pt-BR",
  "words": [
    "astro",
    "astropaper",
    "bcrypt",
    "fontsource",
    "grotesk",
    "hreflang",
    "kebabcase",
    "latin",
    "luztech",
    "mdx",
    "Naing",
    "opengraph",
    "pagefind",
    "pubdatetime",
    "shiki",
    "shikijs",
    "sitemap",
    "slugify",
    "tailwindcss",
    "vercel"
  ],
  "overrides": [
    {
      "filename": "**/pt-BR/**",
      "language": "en,pt,pt-BR"
    },
    {
      "filename": "**/en-US/**",
      "language": "en"
    }
  ],
  "ignorePaths": [
    "dist/**",
    ".astro/**",
    "node_modules/**",
    "pnpm-lock.yaml",
    "public/pagefind/**"
  ]
}
