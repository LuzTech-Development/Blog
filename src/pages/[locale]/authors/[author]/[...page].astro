---
import { render } from 'astro:content';
import type { GetStaticPathsOptions } from 'astro';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Main from '@/components/Main.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Card from '@/components/Card.astro';
import AuthorLink from '@/components/AuthorLink.astro';
import AuthorSocialLinks from '@/components/AuthorSocialLinks.astro';
import Footer from '@/components/Footer.astro';
import Pagination from '@/components/Pagination.astro';
import { getUniqueAuthors, resolveAuthorSlug } from '@/utils/getUniqueAuthors';
import { getSortedPosts } from '@/utils/getSortedPosts';
import { getLocalizedAuthorProfiles } from '@/utils/getLocalizedAuthorProfiles';
import { getLocalizedPosts } from '@/utils/getLocalizedPosts';
import {
  LOCALES,
  assertLocaleParam,
  localeToPath,
  type Locale
} from '@/utils/i18n';
import { useTranslations } from '@/i18n';
import config from '@/config';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const groups = await Promise.all(
    LOCALES.map(async locale => {
      const posts = (await getLocalizedPosts(locale as Locale)).filter(
        ({ data }) => !data.draft
      );
      const authors = getUniqueAuthors(posts);

      return authors.flatMap(author => {
        const authorPosts = getSortedPosts(
          posts.filter(
            ({ data }) => resolveAuthorSlug(data.author) === author.slug
          )
        );

        return paginate(authorPosts, {
          params: {
            locale: localeToPath(locale as Locale),
            author: author.slug
          },
          props: { author },
          pageSize: config.posts.perPage
        });
      });
    })
  );

  return groups.flat();
}

const { page, author } = Astro.props;

const locale = assertLocaleParam(Astro.params.locale);
const t = useTranslations(locale);
const profiles = await getLocalizedAuthorProfiles(locale);
const authorProfile = profiles.get(author.slug);
const profileName = authorProfile?.data.name ?? author.name;
const profileEmail = authorProfile?.data.email ?? author.email;
const profileDescription = authorProfile?.data.description;
const { Content } = authorProfile
  ? await render(authorProfile)
  : { Content: null };
---

<Layout
  title={`${t.pages.authorTitle}: ${profileName} | ${config.site.title}`}
  description={profileDescription ?? `${t.pages.authorDesc} ${profileName}.`}
>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={`${t.pages.authorTitle}: ${profileName}`}
    pageDesc={profileDescription ?? `${t.pages.authorDesc} ${profileName}.`}
  >
    <section class="border-border mb-6 rounded-2xl border p-4 sm:p-6">
      <AuthorLink
        slug={author.slug}
        name={profileName}
        email={profileEmail}
        size="md"
      />

      <AuthorSocialLinks
        github={authorProfile?.data.github}
        linkedin={authorProfile?.data.linkedin}
        website={authorProfile?.data.website}
        x={authorProfile?.data.x}
        email={profileEmail}
      />

      {
        profileDescription && (
          <p class="text-muted-foreground mt-3 text-sm sm:text-base">
            {profileDescription}
          </p>
        )
      }

      {
        Content && (
          <div class="app-prose max-w-app mt-5">
            <Content />
          </div>
        )
      }
    </section>

    <ul>
      {page.data.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
