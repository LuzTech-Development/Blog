---
/**
 * Root landing page.
 *
 * This page never renders content — it's a client-side language detector.
 * Detection order:
 *   1) `localStorage["preferred-locale"]` if the user explicitly picked one
 *   2) `navigator.languages` (any `pt-*` collapses to `pt-BR`, `en-*` to `en-US`)
 *   3) Fallback to `en-US`
 *
 * Every localized page has hreflang alternates so search engines can pick the
 * right variant without depending on this JS-based redirect.
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import { getAssetPath } from "@/utils/withBase";
import {
  LOCALES,
  LOCALE_LABELS,
  LOCALE_URL_PATH,
  DEFAULT_LOCALE,
} from "@/utils/i18n";
import config from "@/config";

const alternates = LOCALES.map(locale => ({
  hreflang: locale,
  href: new URL(getRelativeLocaleUrl(locale, ""), Astro.site ?? Astro.url).href,
  label: LOCALE_LABELS[locale],
}));
const defaultTarget = getRelativeLocaleUrl(DEFAULT_LOCALE, "");
// The detector needs to map canonical codes ("en-US") to their URL path
// segment ("en-us") because Astro's routes are lowercase.
const supportedJson = JSON.stringify(LOCALE_URL_PATH);
---

<!doctype html>
<html lang={DEFAULT_LOCALE}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{config.site.title}</title>
    <link rel="icon" type="image/svg+xml" href={getAssetPath("favicon.svg")} />
    <link rel="canonical" href={new URL("/", Astro.site ?? Astro.url).href} />
    {
      alternates.map(alt => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(defaultTarget, Astro.site ?? Astro.url).href}
    />
    <meta http-equiv="refresh" content={`0; url=${defaultTarget}`} />
    <script is:inline define:vars={{ supportedJson, defaultTarget }}>
      // @ts-nocheck
      (function () {
        try {
          // Map of canonical BCP-47 code -> URL path segment (lowercase).
          const localeToPath = JSON.parse(supportedJson);
          const stored = localStorage.getItem("preferred-locale");
          const pick = tag => {
            if (!tag) return null;
            if (localeToPath[tag]) return tag;
            const lower = tag.toLowerCase();
            if (lower.startsWith("pt")) return "pt-BR";
            if (lower.startsWith("en")) return "en-US";
            return null;
          };
          let target = pick(stored);
          if (!target) {
            const candidates =
              (navigator.languages && navigator.languages.length
                ? navigator.languages
                : [navigator.language]) || [];
            for (const c of candidates) {
              target = pick(c);
              if (target) break;
            }
          }
          if (!target) target = "en-US";
          const path = localeToPath[target] || target.toLowerCase();
          const base = document.baseURI.replace(/\/?$/, "/");
          location.replace(base + path + "/");
        } catch (_) {
          location.replace(defaultTarget);
        }
      })();
    </script>
  </head>
  <body>
    <noscript>
      <h1>{config.site.title}</h1>
      <p>Select a language / Selecione um idioma:</p>
      <ul>
        {
          alternates.map(alt => (
            <li>
              <a href={alt.href}>{alt.label}</a>
            </li>
          ))
        }
      </ul>
    </noscript>
  </body>
</html>
