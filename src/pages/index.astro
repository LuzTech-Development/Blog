---
/**
 * Root landing page.
 *
 * This page never renders content — it's a client-side language detector.
 * Detection order:
 *   1) `localStorage["preferred-locale"]` if the user explicitly picked one
 *   2) `navigator.languages` (any `pt-*` collapses to `pt-BR`, `en-*` to `en-US`)
 *   3) Fallback to `en-US`
 *
 * Every localized page has hreflang alternates so search engines can pick the
 * right variant without depending on this JS-based redirect.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getAssetPath } from '@/utils/withBase';
import {
  LOCALES,
  LOCALE_LABELS,
  DEFAULT_LOCALE,
  buildLocaleDetectorScript
} from '@/utils/i18n';
import config from '@/config';

const alternates = LOCALES.map(locale => ({
  hreflang: locale,
  href: new URL(getRelativeLocaleUrl(locale, ''), Astro.site ?? Astro.url).href,
  label: LOCALE_LABELS[locale]
}));
const defaultTarget = getRelativeLocaleUrl(DEFAULT_LOCALE, '');
const detectorScript = buildLocaleDetectorScript('');
---

<!doctype html>
<html lang={DEFAULT_LOCALE}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{config.site.title}</title>
    <link rel="icon" type="image/svg+xml" href={getAssetPath('favicon.svg')} />
    <link rel="canonical" href={new URL('/', Astro.site ?? Astro.url).href} />
    {alternates.map(alt => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(defaultTarget, Astro.site ?? Astro.url).href}
    />
    <meta http-equiv="refresh" content={`0; url=${defaultTarget}`} />
    <script is:inline define:vars={{ detectorScript }}>
      // @ts-nocheck
      // eslint-disable-next-line no-eval -- executes a server-built inline IIFE for locale detection
      eval(detectorScript);
    </script>
  </head>
  <body>
    <noscript>
      <h1>{config.site.title}</h1>
      <p>Select a language / Selecione um idioma:</p>
      <ul>
        {alternates.map(alt => (
          <li>
            <a href={alt.href}>{alt.label}</a>
          </li>
        ))}
      </ul>
    </noscript>
  </body>
</html>
