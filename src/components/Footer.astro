---
import type { HTMLAttributes } from 'astro/types';
import { getRelativeLocaleUrl } from 'astro:i18n';
import IconRss from '@/assets/icons/IconRss.svg';
import Socials from './Socials.astro';
import LinkButton from './LinkButton.astro';
import { DEFAULT_LOCALE, isLocale } from '@/utils/i18n';
import { useTranslations } from '@/i18n';
import config from '@/config';

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<'footer'>;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const locale = isLocale(Astro.currentLocale)
  ? Astro.currentLocale
  : DEFAULT_LOCALE;
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();

const rssHref = getRelativeLocaleUrl(locale, 'rss.xml').replace(/\/$/, '');
const rssTitle = `${config.site.title} — RSS (${locale})`;
---

<footer
  class:list={['app-layout', { 'mt-auto': !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border flex flex-col items-center justify-between border-t py-6 sm:flex-row-reverse sm:py-4"
  >
    <div class="flex flex-wrap items-center gap-1">
      <Socials />
      <LinkButton
        href={rssHref}
        class="p-2 hover:rotate-6 sm:p-1"
        title={rssTitle}
        aria-label={rssTitle}
      >
        <IconRss
          class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent sm:scale-110"
        />
        <span class="sr-only">{rssTitle}</span>
      </LinkButton>
    </div>
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>{t.footer.copyright} &#169; {currentYear} LuzTech Development</span>
    </div>
  </div>
</footer>
