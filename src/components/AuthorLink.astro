---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { DEFAULT_LOCALE, isLocale } from '@/utils/i18n';
import { gravatarUrl, gravatarSrcSet } from '@/utils/gravatar';
import { getLocalizedAuthorProfiles } from '@/utils/getLocalizedAuthorProfiles';

type Props = {
  slug: string;
  name: string;
  email: string | null | undefined;
  size?: 'sm' | 'md';
  /** Extra classes appended to the outer <a>. */
  class?: string;
};

const { slug, name, email, size = 'sm', class: className = '' } = Astro.props;

const locale = isLocale(Astro.currentLocale)
  ? Astro.currentLocale
  : DEFAULT_LOCALE;

const profiles = await getLocalizedAuthorProfiles(locale);
const profileEmail = profiles.get(slug)?.data.email;
const resolvedEmail = email ?? profileEmail ?? null;

// Avatars are tiny (24–40 px) and served by Gravatar's own CDN in the exact
// requested size (`?s=`). Using Astro's <Image /> here would download every
// avatar at build time, freeze it in the bundle, and break the "user updates
// their Gravatar and it reflects immediately" behaviour — for a payload gain
// measured in ~1–3 KB per avatar. Preconnect + srcset covers the real perf
// wins without giving up live avatars.
const avatarPx = size === 'md' ? 40 : 24;
const avatarSrc = gravatarUrl(resolvedEmail ?? undefined, avatarPx);
const avatarSrcSet = gravatarSrcSet(resolvedEmail ?? undefined, avatarPx);
const avatarClass = size === 'md' ? 'size-10' : 'size-6';
const textClass = size === 'md' ? 'text-base' : 'text-sm';

const href = getRelativeLocaleUrl(locale, `authors/${slug}/`);
---

<a
  href={href}
  rel="author"
  data-pagefind-filter="author"
  class:list={[
    'inline-flex items-center gap-2 align-middle',
    'text-muted-foreground hover:text-accent focus-visible:text-accent',
    'decoration-dashed underline-offset-4 hover:underline',
    'focus-visible:no-underline focus-visible:underline-offset-0',
    textClass,
    className
  ]}
>
  {
    /*
    Rationale: keep the native <img> here instead of Astro's <Image />.
    Gravatar's CDN already returns the exact pixel size we request via `?s=`,
    the avatars are 24–40 px (webp/avif savings are ~1–3 KB per image), and
    <Image /> would download every avatar at build time — freezing them in
    the bundle and breaking live avatar updates. Preconnect + srcset covers
    the real perf wins without giving up that behaviour. The VS Code Astro
    extension may still show a "use <Image />" hint on this element; it's a
    stylistic suggestion, not a correctness issue.
  */
  }
  <img
    src={avatarSrc}
    srcset={avatarSrcSet}
    alt=""
    width={avatarPx}
    height={avatarPx}
    loading="lazy"
    decoding="async"
    referrerpolicy="no-referrer"
    class:list={[
      'border-border bg-muted shrink-0 rounded-full border',
      avatarClass
    ]}
  />
  <span class="font-medium">{name}</span>
</a>
