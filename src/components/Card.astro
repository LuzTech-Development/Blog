---
import type { CollectionEntry } from 'astro:content';
import { getPostUrl } from '@/utils/getPostPaths';
import { getPostAuthor } from '@/utils/getUniqueAuthors';
import { toTransitionName } from '@/utils/toTransitionName';
import AuthorLink from './AuthorLink.astro';
import Datetime from './Datetime.astro';

type Props = {
  variant?: 'h2' | 'h3';
} & CollectionEntry<'posts'>;

const post = Astro.props;
const { variant: Heading = 'h2', id, data, filePath } = post;

const { title, description, ...props } = data;
const author = getPostAuthor(post);
---

<li class="my-6">
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class:list={[
      'text-accent inline-block text-lg font-medium',
      'decoration-dashed underline-offset-4 hover:underline',
      'focus-visible:no-underline focus-visible:underline-offset-0'
    ]}
  >
    <Heading transition:name={toTransitionName(title)}>
      {title}
    </Heading>
  </a>
  <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
    <Datetime {...props} />
    {
      author && (
        <AuthorLink
          slug={author.slug}
          name={author.name}
          email={author.email}
          size="sm"
        />
      )
    }
  </div>
  <p>{description}</p>
</li>
